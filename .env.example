# Configuración de Entorno - Copia este archivo a .env.local y completa los valores
# IMPORTANTE: .env.local está en .gitignore y NO se sincronizará con Git

# ==========================================
# CONFIGURACIÓN DE EMAILS
# ==========================================

# Email de contacto principal para recibir cotizaciones
NEXT_PUBLIC_CONTACT_EMAIL=tu-email-de-contacto@dominio.com

# Email para notificaciones internas
NEXT_PUBLIC_NOTIFICATION_EMAIL=tu-email-de-notificaciones@dominio.com

# Configuración SMTP para envío de emails
NEXT_PUBLIC_SMTP_HOST=smtp.gmail.com
NEXT_PUBLIC_SMTP_PORT=587
NEXT_PUBLIC_SMTP_USER=tu-remitente@gmail.com
NEXT_PUBLIC_SMTP_PASS=tu-contraseña-app-google

# Datos de contacto para footer y WhatsApp
NEXT_PUBLIC_CONTACT_PHONE=1136834491
NEXT_PUBLIC_CONTACT_PHONE_DISPLAY=1136834491
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/tu-usuario
NEXT_PUBLIC_INSTAGRAM_LABEL=@tu-usuario
NEXT_PUBLIC_WHATSAPP_MESSAGE=Hola, vengo de ZWOL-HOME y quiero consultar por un proyecto.

# ==========================================
# CONFIGURACIÓN DE APLICACIÓN
# ==========================================

# URL base de la aplicación
NEXT_PUBLIC_APP_URL=https://zwol-home.com
NEXT_PUBLIC_APP_NAME=ZWOL-HOME
# ==========================================
# OPCIONALES: APIs EXTERNAS
# ==========================================

# Google Maps (para mostrar ubicación)
# NEXT_PUBLIC_GOOGLE_MAPS_KEY=tu-api-key

# Stripe (para pagos)
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# Posthog (para analytics)
# NEXT_PUBLIC_POSTHOG_KEY=phc_...
